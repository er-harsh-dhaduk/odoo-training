<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_cohort_school" model="ir.ui.view">
        <field name="name">school.cohort.view</field>
        <field name="model">wb.school</field>
        <field name="arch" type="xml">
            <cohort string="School Cohort View...."
                    mode="churn"
                    disable_linking="1"
                    interval="week"
                    measure="amount"
                    date_start="start_date" date_stop="end_date"/>
        </field>
    </record>

    <record id="gantt_school_view" model="ir.ui.view">
        <field name="name">gantt.school.view</field>
        <field name="model">wb.school</field>
        <field name="arch" type="xml">
            <gantt date_start="start_date" date_stop="end_date" string="School Gantt View"
                default_group_by="status_id"
                   decoration-info="status_id[0] == 1"
                   decoration-warning="status_id[0] == 2"
                   decoration-secondary="status_id[0] == 3"
                   decoration-danger="status_id[0] == 4"
                   decoration-success="status_id[0] == 5"
                   color="status_id"
                   default_scale="day"
                   scales="day,week,month"
                   disable_drag_drop="True"
                   create="0"
                   edit="0"
                   delete="0"
                   total_row="True"
                   dependency_field="child_school_ids"
                   dependency_inverted_field="parent_school_ids"

            >
                <templates>
                    <div t-name="gantt-popover">
                        <b>Name: </b><t t-out="name" /> <br/>
                        <b>Start Date </b><t t-out="start_date.toFormat('f ')" /><br/>
                        <b>End Date </b><t t-out="end_date.toFormat(' f')" /><br/>
                        <b>Status ID </b><t t-out="status_id[0]" /><br/>
                        <b>Status Name </b><t t-out="status_id[1]" /><br/>
                        <b>Fees </b><t t-out="amount" /><br/>
                    </div>
                </templates>
                <field name="name" />
                <field name="amount" />

            </gantt>
        </field>
    </record>

    <record id="student.wb_school_action" model="ir.actions.act_window">
        <field name="view_mode">list,gantt,cohort,form</field>
    </record>
</odoo>
<odoo>

    <record id="wb_student_search_view" model="ir.ui.view">
        <field name="name">wb.stduent.search.view</field>
        <field name="model">wb.student</field>
        <field name="arch" type="xml">
            <search>
                <filter name="create_date" string="Create Date" date="create_date" start_year="-2" end_year="5" start_month="-3" end_month="3">
<!--                    January 25 -> December 24, November24 and October24-->
<!--                    January 25, Feb, March-->
                    <filter name="30_days" string="30Days"
                    domain="[('create_date','&gt;', datetime.datetime.combine(context_today() - relativedelta(days=30), datetime.time(23,59,59)).to_utc())]"
                />
                    <filter name="7_days" string="7Days"
                    domain="[('create_date','&gt;', datetime.datetime.combine(context_today() - relativedelta(days=7), datetime.time(23,59,59)).to_utc())]"
                />
                <filter name="14_days" string="14Days"
                    domain="[('create_date','&gt;', datetime.datetime.combine(context_today() - relativedelta(days=14), datetime.time(23,59,59)).to_utc())]"
                />
                </filter>

                <field name="name" />
                <field name="school_id" />
                <field name="gender" />

                <filter name="student_name" domain="[('name','ilike','sunny')]" string="Sunny Student" />
                <separator />
                <filter name="school_name" domain="[('school_id.name','ilike','sunny')]" string="School Sunny" />
                <separator />
                <filter name="gender_male_filter" domain="[('gender','=','male')]" string="Male Students" />
                <filter name="gender_female_filter" domain="[('gender','=','female')]" string="Female Students" />

                <group>
                    <filter name="gender_groupby"
                            context="{'group_by':'gender'}"
                            domain="[]"
                            string="Gender" />
                    <filter name="school_groupby"
                            context="{'group_by':'school_id'}"
                            domain="[]"
                            string="School" />
                </group>

                <searchpanel>
                    <field name="gender" string="Gender" select="multi" icon="fa-truck" color="#875A7B"/>
                    <field name="school_id" string="School" enable_counters="1" icon="fa-cutlery" color="red"/>
                </searchpanel>

            </search>
        </field>
    </record>


    <record id="wb_student_tree_view" model="ir.ui.view">
      <field name="name">wb.student.list.view</field>
      <field name="model">wb.student</field>
      <field name="arch" type="xml">
<!--          <list string="Student" delete="0" create="0" edit="0" import="0" export_xlsx="0">-->
          <list string="Student">
<!--        <list string="Student"-->
<!--            decoration-bf="id == 1" decoration-it="id == 2"-->
<!--            decoration-info="id == 1"-->
<!--            decoration-warning="id == 2"-->
<!--            decoration-danger="id == 3"-->
<!--            decoration-primary="id == 7"-->
<!--            decoration-muted="id == 8"-->
<!--            decoration-success="id == 9" >-->
              <field name="sequence" widget="handle"/>
              <field name="sequence" />
            <field name="id" decoration-info="1"/>
              <field name="create_date" />
            <field name="school_id" decoration-bf="1" decoration-warning="id == 1" decoration-danger="id != 1"/>
            <groupby name="school_id">
                <button type="edit" name="edit" icon="fa-edit" title="Edit" />
                <button type="object" name="abc_test" string="Click Here" />
            </groupby>
              <field name="roll_number" decoration-it="1"/>
              <field name="name" decoration-muted=" id in (1,2,4,10) or id not in (5, 8)" />
              <field name="name1"  decoration-primary="1" />
              <field name="is_paid"  />
            <field name="student_fees" sum="Total Fees"  decoration-danger="1" />
            <field name="discount_fees" sum="Total Discount" decoration-danger="1" />
            <field name="final_fees" avg="Average of Final Fees" decoration-success="1" />
              <field name="status" />
        </list>
      </field>
    </record>

   <record id="wb_student_form_view" model="ir.ui.view">
      <field name="name">wb.student.form.view</field>
      <field name="model">wb.student</field>
      <field name="arch" type="xml">
          <form>
<!--        <form string="Student" duplicate="0" edit="0" delete="0" create="0">-->
            <header>
                <button name="custom_method" type="object" string="Custom Method" />
                <button name="duplicate_records" type="object" string="Duplicate Records (Create)" />
                <button name="delete_records" type="object" string="Remove/Delete Records (Unlink)" />
                <button name="json_data_store"  type="object" string="JSON FEED" />
                <field name="status" widget="statusbar"  />
            </header>
            <sheet >
                <div class="oe_title">
                    <h1>
                        <field name="name"/>
                    </h1>
                </div>
                <field name="status" />
                <field name="student_image" widget="image" />
                <notebook>
                    <page string="Student Detail">
<!--                        <group>-->
                            <group>
                                <field name="student_user_id" />
                                <field name="teacher_user_id" />
                                <field name="company_id" />
                                <field name="is_default_demo" />
                                <field name="name1" />
                                <field name="name2" invisible="1"/>
                                <field name="name3" />
                                <field name="name4" readonly="1"/>
                                <field name="address" string="STD Address"/>
                                <field name="student_name" string="STD NM" required="1"/>
                                <field name="roll_number" string="Unique Number" help="Please use here unique enrollment number." placeholder="Enter here Enrollment Number"/>
                            </group>
<!--                        </group>-->
                    </page>
                    <page string="School Detail">
                        <group >
                            <field name="school_ids" widget="many2many_tags"/>
                            <field name="hobby_list_ids" widget="many2many_tags"/>
                            <field name="school_id" string="School" placeholder="Please select school"/>
                            <field name="joining_date" string="Joining Date Student" required="1" placeholder="Please enter student joining date."/>
                            <field name="is_paid" string="Override Paid Label" readonly="1"/>
                            <field name="school_data" />
                            <field name="student_fees" string="STD Fees" placeholder="You can enter here current year fees."/>
                            <field name="discount_fees" />
                        </group>
                    </page>
                    <page string="Fees and Gender" >
                        <group string="Student Fees">
                            <field name="final_fees" />
                            <field name="final_fees1" />
                        </group>

                        <group string="Student Gender" >
                            <field name="combobox" string="Combo Selection" required="1" help="Please select gender." placeholder="Please select any of the option."/>
                            <field name="gender" />
                            <field name="advance_gender" />
                            <field name="vip_gender" placeholder="Hello Please Select VIP Options....."/>
                        </group>
                    </page>
                    <page string="Description" invisible="gender == 'male'">
                        <group>
                            <group string="Description">
                                <field name="address_html"
                                       string="Override HTML Label" placeholder="Hello enter here your html information."
                                       readonly="0" required="1"
                                />
        <!--                        <separator string="Both having long content fields."/>-->
        <!--                    <newline/>-->
                            </group>
                            <group string="HTML Description">
                                <field name="compute_address_html" />
                            </group>
                        </group>
                    </page>
                </notebook>
<!--                <group></group>-->
            </sheet>
        </form>
      </field>
    </record>

    <record id="wb_student_kanban_view" model="ir.ui.view">
        <field name="name">wb.student.kanban.view</field>
        <field name="model">wb.student</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="status">
                <progressbar field="status"
                             sum_field="student_fees"
                    colors='{"Draft":"success","In Progress":"warning","Finish":"danger"}'
                />
                <templates>
                    <field name="status" />
                    <t t-name="card">
                        <div class="row">
                            <div class="col-4">
                                <aside class="o_kanban_aside_full">
                                    <div class="o_kanban_image_fill position-relative w-100">
                                        <field name="student_image" class="h-100" widget="image" option="{'img_class':'object-fit-cover'}" />
                                    </div>
                                </aside>
                            </div>
                            <div class="col-4">
                                <field class="fw-bolder" name="name" />
                            </div>
                            <div class="col-4">
                                <field class="badge rounded-pill" name="student_fees" />
                            </div>
                        </div>
<!--                        <div>-->
<!--                            <strong>-->
<!--                                School:-->
<!--                            </strong>-->
<!--                            <field name="school_id"/>-->
<!--                        </div>-->
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="student_profile_graph_view" model="ir.ui.view">
        <field name="name">student.profile.graph.view</field>
        <field name="model">wb.student</field>
        <field name="arch" type="xml">
            <graph string="Student Graph" type="pie" disable_linking="1" stacked="0">
                <field name="create_date" interval="year"/>
                <field name="name" />
                <field name="school_id" />
                <field name="gender" />
                <field name="student_fees" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="student_prodfile_pivot_view" model="ir.ui.view">
        <field name="name">student.prodfile.pivot_view</field>
        <field name="model">wb.student</field>
        <field name="group_ids" eval="[(4, ref('student.student_admin_group'))]"/>
        <field name="arch" type="xml">
            <pivot string="From Student Pivot View" disable_linking="1" display_quantity="1" default_order="student_fees">
                <field name="create_date" interval="year" type="row" />
                <field name="school_id"  />
                <field name="name" />
                <field name="student_fees" type="measure"/>
                <field name="gender" type="col"/>
            </pivot>
        </field>
    </record>

  <record id="wb_student_action" model="ir.actions.act_window">
    <field name="name">Student</field>
    <field name="res_model">wb.student</field>
      <field name="group_ids" eval="[(4, ref('student.student_admin_group'))]"/>
    <field name="view_mode">list,pivot,form,kanban,graph</field>
<!--      <field name="context">{'search_default_student_name':1,'search_default_gender_groupby':1}</field>-->
  </record>

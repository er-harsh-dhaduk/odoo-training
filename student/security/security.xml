<!--        </record>-->



        <record id="student_own_record_group" model="res.groups">
            <field name="name">Student</field>
            <field name="privilege_id" ref="student.student_sub_module_category" />
        </record>

        <record id="student_teacher_group" model="res.groups">
            <field name="name">Teacher</field>
            <field name="privilege_id" ref="student.student_sub_module_category" />
            <field name="implied_ids" eval="[(4, ref('student.student_own_record_group'))]" />
        </record>

        <record id="student_admin_group" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="student.student_sub_module_category" />
            <field name="implied_ids" eval="[(4, ref('student.student_teacher_group'))]" />
        </record>

        <record id="student_rule_id" model="ir.rule">
            <field name="name">Student: Own Records Only</field>
            <field name="model_id" ref="model_wb_student" />
            <field name="domain_force">[('student_user_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('student.student_own_record_group'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>

        <record id="teacher_rule_id" model="ir.rule">
            <field name="name">Teacher: Assigned Students Records Only</field>
            <field name="model_id" ref="model_wb_student" />
            <field name="domain_force">[('teacher_user_id','=',user.id),'|',('company_id','=', user.company_id.id), ('company_id','in', user.company_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('student.student_teacher_group'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>

        <record id="admin_rule_id" model="ir.rule">
            <field name="name">Student: Own Records Only</field>
            <field name="model_id" ref="model_wb_student" />
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('student.student_admin_group'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="True" />
            <field name="perm_create" eval="True" />
            <field name="perm_unlink" eval="True" />
        </record>

    </data>

</odoo>

<!--[(fieldname, operator name, value)]-->

<!--1. Equality:-->

<!--[('field', '=', value)]        # Equal to-->
<!--[('field', '!=', value)]       # Not equal to-->

<!--2. Comparisons:-->

<!--[('field', '>', value)]        # Greater than-->
<!--[('field', '>=', value)]       # Greater or equal-->
<!--[('field', '<', value)]        # Less than-->
<!--[('field', '<=', value)]       # Less or equal-->

<!--3. List operations:-->

<!--[('field', 'in', [1, 2, 3])]   # In list-->
<!--[('field', 'not in', [1, 2])]  # Not in list-->

<!--4. Text matching:-->

<!--[('field', 'like', 'text')]    # Contains (case-sensitive)-->
<!--[('field', 'ilike', 'text')]   # Contains (case-insensitive)-->


<!--5. Boolean:-->

<!--[('field', '=', True)]         # Is True-->
<!--[('field', '=', False)]        # Is False or not set-->

